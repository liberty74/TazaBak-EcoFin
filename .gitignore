# Исходники роликов для витрины. В сборку идут копии из
# frontend/public/media — держать в истории оба комплекта незачем.
videos/

# Видео-демо весит 102 МБ — GitHub не принимает файлы больше 100 МБ, и попытка
# запушить его обрывает весь push, а не только этот файл.
presentation/*.mp4
