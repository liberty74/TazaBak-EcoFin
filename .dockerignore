# Что не должно попасть в контекст сборки.
.git
.github
.venv
__pycache__
.pytest_cache
*.pyc
*.pt

# Локальная база и WAL-файлы: в контейнере база живёт в томе.
tazabak.db*

# Загруженные пользователями изображения — не часть образа.
static/bio/*
static/vision/*

# Секреты. Значения приходят через environment в compose.
.env
.env.*
!.env.example

# Внутренние документы команды.
CONTEXT.md
PLAN_ECOFIN.md
Context

# Материалы к сдаче и записи. Вместе это больше 150 МБ, которые Docker иначе
# копирует в контекст сборки на каждый build — образу они не нужны ни в одном
# слое.
presentation
videos

# Данные встроенного PostgreSQL от прежней локальной конфигурации.
.pgdata
.pgdata_uri.txt

# Фронтенд собирается своим Dockerfile со своим контекстом.
frontend
tests
docs
firmware
scripts
